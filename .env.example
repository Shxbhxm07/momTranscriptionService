# Host paths to the two large model weight directories.
#
# These are NOT vendored into this project — gpt-oss-120b is 61 GB and ggml-large-v3 is
# 2.9 GB. Images carry code; volumes carry weights. Copy this file to `.env` and point
# these at wherever the weights live on your machine.
#
#   cp .env.example .env

# whisper.cpp GGUF models. MUST contain ggml-large-v3.bin (the MULTILINGUAL model — the
# .en variants cannot translate, so Hindi would come back as Hindi) and
# ggml-silero-v6.2.0.bin for VAD.
WHISPER_MODELS_DIR=/home/admin/whisper.cpp/models

# gpt-oss-120b weights (the directory holding config.json + the 14 safetensors shards).
LLM_MODEL_DIR=/home/admin/models/openai/gpt-oss-120b

# Hybrid test mode only (docker-compose.online.yml). Local whisper + NeMo, remote MoM writer.
# Leave this unset for normal fully-offline operation — nothing reads it then.
# OPENROUTER_API_KEY=sk-or-v1-...
