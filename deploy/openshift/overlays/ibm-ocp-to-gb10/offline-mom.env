# offline-mom-config ConfigMap: IBM-OCP-TO-GB10 (app on OCP, speech on the GB10 over the LAN, LLM on IBM watsonx)
#
# Consumed by every Deployment through:
#     envFrom:
#       - configMapRef:
#           name: offline-mom-config
#
# Kustomize hashes this file into the ConfigMap name and rewrites those references, so editing a
# value here rolls the affected pods automatically. No image rebuild. Extra keys a service does not
# read are harmless. Credentials are NOT here: they live in the offline-mom-secrets Secret.
# Set every CHANGE_ME before applying:   grep -n CHANGE_ME offline-mom.env

APP_MODE=offline

# --- Speech: whisper + NeMo on the GB10, over the LAN ---
# The same split mom-ai uses. REQUIRES a firewall rule: OCP pod CIDR -> 11.0.0.34 on 8080 and 8003.
# If the GB10 is off, MoM stops: it becomes a hard dependency.
# Speech settings (model paths, SPEAKER_CLEANUP) are set on the GB10, in its docker-compose.yml.
WHISPERCPP_URL=http://11.0.0.34:8080
NEMO_URL=http://11.0.0.34:8003

# --- Minutes + document translation: IBM watsonx (Cloud Pak for Data) ---
# Use .../ml/v1/text/chat if scripts/ibm_check.py finds it (keeps JSON-schema extraction),
# otherwise .../ml/v1/text/generation. The URL is complete, including ?version=.
VLLM_API_BASE=https://cpd-watsonx-imir.apps.ocp4.iaf.in/ml/v1/text/chat?version=2023-05-29
LLM_MODEL_PATH=meta-llama/llama-3-3-70b-instruct
WATSONX_PROJECT_ID=CHANGE_ME
CP4D_AUTH_URL=https://cpd-watsonx-imir.apps.ocp4.iaf.in/icp4d-api/v1/authorize
LLM_AUTH_MODE=cp4d
CP4D_TOKEN_TTL=3600
# Self-signed cluster certificate; the reference IAF integration disables verification too.
LLM_VERIFY_SSL=false
# OpenRouter-only provider pinning. Must stay empty on watsonx.
LLM_PROVIDER_ORDER=
# Parallel LLM calls per meeting. Raise only if the watsonx quota allows it.
LLM_CONCURRENCY=2
MODEL_CONTEXT_LIMIT=32768

# --- Internal wiring (Service names in this namespace) ---
LLAMA_URL=http://llama-service:8001
MOM_API_URL=http://transcribe-api:8000/transcribe-and-generate-mom

# --- Kafka ---
KAFKA_BOOTSTRAP=CHANGE_ME:9092
KAFKA_JOB_TOPIC=CHANGE_ME
KAFKA_ACK_TOPIC=CHANGE_ME
KAFKA_GROUP_ID=offline-mom-consumer
# A safety net only; jobs longer than this are handled in code.
KAFKA_MAX_POLL_INTERVAL_MS=1200000

# --- MinIO (credentials are in the Secret) ---
MINIO_ENDPOINT=CHANGE_ME:9000
MINIO_SECURE=false
# Empty = the first path segment of each job's file_urls is the bucket.
MINIO_INPUT_BUCKET=
MINIO_SUMMARY_BUCKET=CHANGE_ME

# --- Elasticsearch (credentials are in the Secret) ---
ELASTIC_URL=http://CHANGE_ME:9200
ELASTIC_INDEX_ATTACHED=CHANGE_ME
ELASTIC_INDEX_INGESTED=CHANGE_ME
# false if your team owns the index mappings.
ELASTIC_CREATE_INDICES=true

# --- MoM accuracy features (each one measured; leave as shipped) ---
MOM_WINDOW_KEY_POINTS=true
MOM_MERGE_ITEMS=true
# Built but not yet measured on its own.
MOM_VERIFY_DECISIONS=false
ENABLE_DIARIZATION=true
ENABLE_SPEAKER_NAMING=true
ENABLE_TRANSCRIPT_CORRECTION=true
ENABLE_TRANSCRIBE_RETRY=true
ENABLE_LANG_DETECT=true
FILTER_HALLUCINATIONS=true

# --- Document translation ---
ENABLE_OCR=true
OCR_LANGS=hin+eng
MAX_DOC_MB=50
MAX_UPLOAD_MB=500

# --- Air gap ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
