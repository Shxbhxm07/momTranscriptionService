# offline-mom-secrets: the credential KEYS only. Copy to secrets.env, fill in, and create the Secret:
#     oc create secret generic offline-mom-secrets --from-env-file=secrets.env -n offline-mom
# Never commit the filled copy (secrets.env is in .gitignore). Everything that is not a secret lives
# in the overlay's offline-mom.env.

# --- IBM watsonx (Cloud Pak for Data) ---
CP4D_USERNAME=
CP4D_API_KEY=

# --- MinIO ---
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Elasticsearch (leave both empty if the cluster has no authentication) ---
ELASTIC_USER=
ELASTIC_PASSWORD=

# --- IBM Cloud watsonx (LLM_AUTH_MODE=iam) ---
# The IBM Cloud API key. Not needed for watsonx on Cloud Pak for Data, which uses CP4D_USERNAME
# and CP4D_API_KEY above instead. Accepts a comma-separated list if you have more than one.
WATSONX_API_KEY=

# --- Only when testing on OpenRouter instead of watsonx (OVERLAYS.md) ---
# Same slot, any provider: LLM_API_KEY is read when WATSONX_API_KEY is unset. GROQ_API_KEYS is
# still read last, so older deployments keep working.
# LLM_API_KEY=
