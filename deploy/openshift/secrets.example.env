# offline-mom-secrets: the credential KEYS only. Copy to secrets.env, fill in, and create the Secret:
#     oc create secret generic offline-mom-secrets --from-env-file=secrets.env -n offline-mom
# Never commit the filled copy (secrets.env is in .gitignore). Everything that is not a secret lives
# in the overlay's offline-mom.env.

# --- IBM watsonx (Cloud Pak for Data) ---
CP4D_USERNAME=
CP4D_API_KEY=

# --- MinIO ---
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Elasticsearch (leave both empty if the cluster has no authentication) ---
ELASTIC_USER=
ELASTIC_PASSWORD=

# --- Only when testing on OpenRouter instead of watsonx (OVERLAYS.md) ---
# The variable name is historical: it carries the OpenRouter key. Not needed for watsonx; the
# service starts without it on any backend that is not Groq.
# GROQ_API_KEYS=
